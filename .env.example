# ─────────────────────────────────────────────────────────────────────────────
# Copy this to `.env` and edit. `docker compose up -d` reads it for BOTH the
# container environment and `${VAR}` interpolation (core#736).
#
# ⚠️ Hostnames below are COMPOSE SERVICE NAMES (`postgres`, `redis`), not
# localhost. Inside a container `localhost` is that container itself, so a
# localhost URL here means the app cannot reach its own database — it is not a
# connection to the host. If you instead run the app on your machine with only
# the datastores in Docker (`docker compose up -d postgres redis`, then
# `uv run reflex run`), swap both hostnames back to `localhost`.
#
# ⚠️ The password appears in three places below and they must agree. Changing
# POSTGRES_PASSWORD alone leaves DATABASE_URL pointing at the old one; the same
# is true of REDIS_PASSWORD and REDIS_URL.
# ─────────────────────────────────────────────────────────────────────────────

# Database
POSTGRES_USER=datanika
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=datanika
DATABASE_URL=postgresql+asyncpg://datanika:change-me-to-a-strong-password@postgres:5432/datanika
DATABASE_URL_SYNC=postgresql://datanika:change-me-to-a-strong-password@postgres:5432/datanika

# Redis
# REDIS_PASSWORD is required by docker-compose.yml (strict interpolation).
# Must be set before running `docker compose up -d redis` — the compose
# command will refuse to start without it.
#
# ⚠️ REDIS_URL must carry that password (`redis://:PASSWORD@redis:6379/0`) and
# the `redis` hostname. It is not only Celery's broker: docker-compose.yml
# interpolates it into REFLEX_REDIS_URL, and Reflex does not fail on a Redis it
# cannot reach — it silently falls back to a PER-PROCESS session store while
# running 4 workers, so a reconnect landing on another worker is served a stale
# session, which in this app is a logout. Measured at 48% of reconnects on
# production before core#646. A wrong value here is invisible until users
# report random logouts.
REDIS_PASSWORD=change-me-to-a-strong-password
REDIS_URL=redis://:change-me-to-a-strong-password@redis:6379/0

# Auth
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for stored credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-with-fernet

# dbt
DBT_PROJECTS_DIR=./dbt_projects

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password

# App
APP_NAME=Datanika
DEBUG=false
