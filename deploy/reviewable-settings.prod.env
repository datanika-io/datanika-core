# Resolved reviewable production settings. A change to a flag is this diff.
# Values are what the settings object must resolve, not a raw env-file token.
# Secret-pattern names do not belong here.
DATANIKA_EDITION=cloud
DATANIKA_ALLOW_LOCAL_FILE_PATHS=false
DATANIKA_BYTES_QUOTA_ENFORCE=true
DATANIKA_OVERAGE_CHARGE_ENABLE=true
DATANIKA_E2E_ADMIN_ENABLE=false
PADDLE_ENVIRONMENT=production
